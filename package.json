{
  "name": "symptom-map",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @symptom-map/web dev",
    "build": "corepack pnpm --filter @symptom-map/web build",
    "preview": "corepack pnpm --filter @symptom-map/web preview",
    "typecheck": "corepack pnpm --filter @symptom-map/web exec tsc -b",
    "test": "corepack pnpm build && node --test scripts/*.test.mjs"
  }
}
